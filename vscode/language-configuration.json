{
  "comments": {
    "lineComment": "чутки:"
  },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [["(", ")"]],
  "wordPattern": "[A-Za-z0-9_А-яЁёІіЇїЄєҐґ'ʼ]+",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(якшо\\s+реально(\\s.*)?|а\\s+нє)\\s*$",
    "decreaseIndentPattern": "^\\s*(отакої|а\\s+нє)(?![A-Za-z0-9_А-яЁёІіЇїЄєҐґ]).*$"
  }
}
